{
  // Zed settings
  //
  // For information on how to configure Zed, see the Zed//zed.dev/docs/configuring-zed
  //
  // To see all of Zed's default settings without changing your
  // custom settings, run `zed: open default settings` from the
  // command palette (cmd-shift-p / ctrl-shift-p)
  "auto_update": false,
  "buffer_font_fallbacks": [ "Symbols Nerd Font" ],
  "cli_default_open_behavior": "new_window",
  "ui_font_fallbacks": [ "Symbols Nerd Font" ],
  "wrap_guides": [ 80, 100, 120, 160, 200 ],

  "agent": {
    "dock": "right",
    "expand_edit_card": true,
    "expand_terminal_card": false,
    "favorite_models": [ ],
    "limit_content_width": false,
    "max_content_width": 1200.0,
    "max_idle_retained_threads": 20,
    "model_parameters": [ ],
    "thinking_display": "auto",
    "threads_sidebar": {
      "position": "right"
    },
  },
  "debugger": {
    "button": false,
  },
  "diagnostics": {
    "button": false,
  },
  "edit_predictions": {
    "allow_data_collection": "no"
  },
  "markdown_preview": {
    "max_width": 1200.0
  },
  "project_panel": {
    "dock": "left",
    "diagnostic_badges": true,
    "bold_folder_labels": false,
    "entry_spacing": "standard",
    "git_status_indicator": true,
    "folder_indicator": "chevron",
  },
  "status_bar": {
    "pending_keystrokes_indicator": true,
    "line_endings_button": true,
  },
  "tabs": {
    "git_status": true,
  },
  "tab_bar": {
    "show_pinned_tabs_in_separate_row": true,
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false,
  },
  "terminal": {
    "starts_open": true,
  },
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark",
  },
  "title_bar": {
    "show_branch_status_icon": true,
  },
}
