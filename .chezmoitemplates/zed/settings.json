{
  // Zed settings
  //
  // For information on how to configure Zed, see the Zed//zed.dev/docs/configuring-zed
  //
  // To see all of Zed's default settings without changing your
  // custom settings, run `zed: open default settings` from the
  // command palette (cmd-shift-p / ctrl-shift-p)
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "terminal": {
    "starts_open": true,
  },
  "project_panel": {
    "dock": "left",
    "diagnostic_badges": true,
    "bold_folder_labels": false,
    "entry_spacing": "standard",
    "git_status_indicator": true,
    "folder_indicator": "chevron",
  },
  "tab_bar": {
    "show_pinned_tabs_in_separate_row": true,
  },
  "tabs": {
    "git_status": true,
  },
  "title_bar": {
    "show_branch_status_icon": true,
  },
  "debugger": {
    "button": false,
  },
  "diagnostics": {
    "button": false,
  },
  "status_bar": {
    "pending_keystrokes_indicator": true,
    "line_endings_button": true,
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false,
  },
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark",
  },

  "auto_update": false,
  "buffer_font_fallbacks": ["Symbols Nerd Font"],
  "cli_default_open_behavior": "new_window",
  "ui_font_fallbacks": ["Symbols Nerd Font"],
  "wrap_guides": [80, 100, 120, 160],
}
